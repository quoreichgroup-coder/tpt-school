# Generate each secret separately with: openssl rand -hex 32
# Use a hexadecimal PostgreSQL password so it is safe in the connection URL.
POSTGRES_PASSWORD=
AUTH_SECRET=
# Optional. Required to run the scheduled fee-reminder endpoint.
CRON_SECRET=
NEXTAUTH_URL=http://localhost:3000
# For commands running on the host; replace PASSWORD with the value above.
# Compose supplies DATABASE_URL using its internal db hostname.
DATABASE_URL=postgresql://tpt:PASSWORD@localhost:5432/tpt_school
PORT=3000
BIND_ADDRESS=127.0.0.1
# Optional: current temporary Cloudflare Tunnel hostname (no protocol).
TUNNEL_HOST=
POSTGRES_PORT=5433
